# Copiar a .env.local y completar con los valores reales para desarrollo local.
# En Vercel estas mismas variables ya están configuradas de forma segura.

# Cadena de conexión a PostgreSQL (Neon)
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require

# Clave de acceso al panel /admin.html
ADMIN_TOKEN=cambiar-por-clave-segura
